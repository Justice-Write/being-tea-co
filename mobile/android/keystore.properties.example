# Copy to keystore.properties (git-ignored) and fill in locally.
# storeFile is relative to mobile/android/. Keep the keystore OUTSIDE the repo,
# e.g. ../../../being-tea-release/being-tea-upload.jks, and back it up.
# Never paste these values into chat, issues, or commits.
storeFile=
storePassword=
keyAlias=being-tea-upload
keyPassword=
